{
  "name": "brotli-dec-wasm",
  "version": "2.3.2",
  "description": "Brotli decompressor for browsers and web workers with WASM, in about 200KB",
  "scripts": {
    "build": "npm run build:wasm && npm run build:ts && npm run minify",
    "build:wasm": "wasm-pack build -t web",
    "build:ts": "tsc",
    "minify": "esbuild pkg/brotli_dec_wasm.js --minify --outfile=pkg/brotli_dec_wasm.js --allow-overwrite && esbuild index.js --minify --outfile=index.js --allow-overwrite",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ustclug-dev/brotli-dec-wasm.git"
  },
  "keywords": [
    "brotli",
    "brotli-decompressor",
    "wasm",
    "rust"
  ],
  "author": "Yulong Ming <i@myl7.org> (https://myl7.org)",
  "license": "MIT OR Apache-2.0",
  "bugs": {
    "url": "https://github.com/ustclug-dev/brotli-dec-wasm/issues"
  },
  "homepage": "https://github.com/ustclug-dev/brotli-dec-wasm#readme",
  "files": [
    "pkg/brotli_dec_wasm_bg.wasm",
    "pkg/brotli_dec_wasm_bg.wasm.d.ts",
    "pkg/brotli_dec_wasm.d.ts",
    "pkg/brotli_dec_wasm.js",
    "*.js",
    "*.d.ts",
    "LICENSE-*.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./web": {
      "types": "./pkg/brotli_dec_wasm.d.ts",
      "import": "./pkg/brotli_dec_wasm.js",
      "default": "./pkg/brotli_dec_wasm.js"
    },
    "./web/bg.wasm": {
      "types": "./pkg/brotli_dec_wasm_bg.wasm.d.ts",
      "import": "./pkg/brotli_dec_wasm_bg.wasm",
      "default": "./pkg/brotli_dec_wasm_bg.wasm"
    }
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.8",
    "esbuild": "^0.28.1",
    "playwright": "^1.59.1",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
